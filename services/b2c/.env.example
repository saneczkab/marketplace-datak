APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

POSTGRES_DB=b2c
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@b2c-db:5432/${POSTGRES_DB}"
DATABASE_VERBOSE=false

SESSION_EXPIRE_SECONDS=3600
SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"

X_SERVICE_KEY=none

B2B_BASE_URL="http://b2b-backend:8000"
B2B_SERVICE_KEY=none
B2B_REQUEST_TIMEOUT=5.0

INBOX_MESSAGES_PROCESSING_DELAY=1
OUTBOX_MESSAGES_PROCESSING_DELAY=1