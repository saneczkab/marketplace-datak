APP_HOST=0.0.0.0
APP_PORT=8002

POSTGRES_DB=moderation
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@moderation-db:5432/${POSTGRES_DB}"

SESSION_EXPIRE_SECONDS=3600
SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=neomarket.events

B2B_SERVICE_KEY="your_b2b_service_key_here"
